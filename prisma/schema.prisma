generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         String         @default("ADMIN")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lastLoginAt  DateTime?
  sessions     AdminSession[]
  logs         AuditLog[]
}

model AdminSession {
  id        String    @id
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([expiresAt])
}

model RateLimit {
  id        String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model CorporateMessage {
  id                  String   @id @default(cuid())
  fullName            String
  email               String
  companyName         String
  contactNumber       String
  subject             String
  message             String
  consent             Boolean
  status              String   @default("New")
  administrativeNotes String   @default("")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, createdAt])
}

model VisitorSession {
  id              String     @id
  deviceType      String
  browserType     String
  operatingSystem String
  referralSource  String
  firstSeenAt     DateTime   @default(now())
  lastSeenAt      DateTime   @default(now())
  visits          Int        @default(1)
  pageViews       PageView[]

  @@index([firstSeenAt])
}

model PageView {
  id               String         @id @default(cuid())
  visitorSessionId String
  visitor          VisitorSession @relation(fields: [visitorSessionId], references: [id], onDelete: Cascade)
  pagePath         String
  timestamp        DateTime       @default(now())

  @@index([timestamp])
}

model ApplicationRelease {
  id                String      @id @default(cuid())
  applicationName   String      @default("Jazba Fuels")
  version           String
  description       String
  releaseNotes      String
  iconPath          String      @default("")
  screenshotPaths   String      @default("[]")
  fileId            String?
  file              StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  releaseStatus     String      @default("Coming Soon")
  publicationStatus String      @default("Draft")
  releaseDate       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  publishedAt       DateTime?

  @@index([publicationStatus, publishedAt])
}

model StoredFile {
  id               String               @id @default(cuid())
  originalName     String
  storedName       String               @unique
  mime             String
  size             Int
  checksum         String
  verified         Boolean              @default(false)
  verificationNote String
  createdAt        DateTime             @default(now())
  releases         ApplicationRelease[]
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  description String
  category    String
  imagePath   String    @default("")
  status      String    @default("Draft")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  @@index([status, publishedAt])
}

model WebsiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id              String    @id @default(cuid())
  administratorId String
  administrator   AdminUser @relation(fields: [administratorId], references: [id], onDelete: Restrict)
  action          String
  entityType      String
  entityId        String
  timestamp       DateTime  @default(now())

  @@index([timestamp])
}
