{
  "name": "jazba-fuels",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:deploy": "node --env-file-if-exists=.env scripts/prepare-db.mjs && prisma migrate deploy",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "maintenance": "node --env-file-if-exists=.env scripts/maintenance.mjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
